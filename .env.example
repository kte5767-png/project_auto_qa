# PostgreSQL (docker-compose.yml)
POSTGRES_USER=autoqa
POSTGRES_PASSWORD=autoqa
POSTGRES_DB=autoqa
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autoqa:autoqa@localhost:5432/autoqa

# 스크린샷·트레이스 저장 위치 (BlobStore 로컬 파일 시스템 구현, D-016)
BLOB_STORE_DIR=./.data/blobs

# 실기기 webOS TV (P0-6, spikes/p0-6-device/README.md)
# 개발자 모드 passphrase는 여기에 넣지 않습니다 (setup 실행 시 직접 입력, 저장 안 함).
WEBOS_HOST=192.168.0.10
WEBOS_DEVICE=tv
# 검수할 앱 ID (appinfo.json의 id). 샘플 앱은 com.autoqa.sampletvapp
WEBOS_APP_ID=
# 리모컨 입력: ssap(실제 리모컨 경로, 기본) | cdp(앱에 키 이벤트 직접 주입)
WEBOS_KEY_MODE=ssap
# 기본 포트 (바꿀 일이 거의 없음)
# WEBOS_SSH_PORT=9922
# WEBOS_INSPECTOR_PORT=9998
# WEBOS_SSAP_PORT=3001
# WEBOS_SSAP_PLAIN_PORT=3000
# 기본 manifest로 리모컨 입력 권한이 부족할 때만: SSAP 등록 manifest JSON 파일 경로
# WEBOS_SSAP_MANIFEST=
