{
	"name": "project-auto-qa",
	"private": true,
	"type": "module",
	"description": "웹 기술로 만든 TV 앱을 실제 TV(webOS)에서 TC 엑셀·Figma 기준으로 검수하는 AI 기반 자동 QA 서비스",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"sample:dev": "pnpm --filter @auto-qa/sample-tv-app dev",
		"sample:verify": "pnpm --filter @auto-qa/sample-tv-app verify",
		"spike:focus": "pnpm --filter @auto-qa/spike-p0-2-focus start",
		"spike:device": "pnpm --filter @auto-qa/spike-p0-6-device start",
		"spike:tc": "pnpm --filter @auto-qa/spike-p0-7-tc start",
		"spike:figma": "pnpm --filter @auto-qa/spike-p0-5-figma start",
		"spike:llm": "pnpm --filter @auto-qa/spike-p0-8-llm start",
		"spike:judge": "pnpm --filter @auto-qa/spike-p0-8-judge start",
		"figma:build": "pnpm --filter @auto-qa/figma-plugin build",
		"check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	}
}
